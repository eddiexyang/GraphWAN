[Unit]
Description=GraphNet network agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
StateDirectory=graphnet-agent
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/graphnet/agent.env
ExecStart=/usr/local/bin/graphnet agent --data-dir /var/lib/graphnet-agent --server ${GRAPHNET_SERVER} --ca ${GRAPHNET_CA} --name ${GRAPHNET_NAME}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
# The agent must see the host network and its TUN device. Do not enable
# PrivateNetwork, PrivateDevices or PrivateUsers for this unit.

[Install]
WantedBy=multi-user.target
